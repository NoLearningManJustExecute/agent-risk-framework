# Normalize line endings in the repo; check out LF everywhere so Windows and
# Linux CI produce identical files and ruff format --check agrees.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artifacts
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.pdf binary
